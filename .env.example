# Envío de emails del formulario de contacto (https://resend.com)
# Sin esta variable, el formulario muestra un error claro en vez de fallar en silencio.
RESEND_API_KEY=

# Remitente verificado en Resend. Mientras no se verifique un dominio propio,
# se usa el remitente de pruebas de Resend (onboarding@resend.dev).
RESEND_FROM_EMAIL="Furiassi Arquitectos <onboarding@resend.dev>"

# Panel de contenidos (Sanity) — ver README > "Panel de contenidos (Sanity)".
# Sin NEXT_PUBLIC_SANITY_PROJECT_ID el sitio usa el contenido local de src/content/.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Token con permiso "Viewer": lo usa el modo edición para mostrar borradores.
SANITY_API_READ_TOKEN=
# Secreto compartido con el webhook de Sanity que actualiza la web al publicar.
SANITY_REVALIDATE_SECRET=
